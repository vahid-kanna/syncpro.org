# ----------------------------------------------------------------------------
# SyncPro Marketing Site Environment Variables (syncpro.org)
# ----------------------------------------------------------------------------

# 1. Web3Forms (Recommended 100% Free Email Forwarder - no backend required)
# Get your free access key at https://web3forms.com (takes 10 seconds, zero setup).
# Submissions will go straight to your inbox.
VITE_WEB3FORMS_ACCESS_KEY=

# 2. Custom Endpoint (Optional: Formspree, Formspark, Supabase Edge Function)
# If set, form will POST JSON payload to this URL.
VITE_WAITLIST_ENDPOINT=

# 3. Direct Contact Email (Fallback for mailto: links and direct outreach)
VITE_CONTACT_EMAIL=founders@syncpro.org
